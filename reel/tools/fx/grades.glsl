//== id: g_portra | Portrait 160 | filter | Film
vec4 effect(vec2 uv) {
  vec3 c = getColor(uv).rgb;
  c *= 1.0300 * vec3(1.0300, 0.9970, 0.9700);
  float l = luma(c);
  c = mix(vec3(l), c, 0.9000);
  c = clamp(c, 0.0, 1.0);
  c = mix(c, c * c * (3.0 - 2.0 * c), 0.2500);
  l = luma(c);
  c += vec3(0.0000, 0.0100, 0.0200) * (1.0 - smoothstep(0.0, 0.55, l)) + vec3(0.0300, 0.0100, -0.0200) * smoothstep(0.45, 1.0, l);
  c = 0.0400 + c * 0.9600;
  return vec4(clamp(c, 0.0, 1.0), 1.0);
}

